{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "dependencyDashboard": true,
    "gitIgnoredAuthors": [
        "216534828+flagsmith-engineering[bot]@users.noreply.github.com"
    ],
    "semanticCommits": "enabled",
    "semanticCommitType": "deps",
    "semanticCommitScope": null,
    "enabledManagers": [
        "custom.regex",
        "github-actions"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/sdk-spec\\.yml$/"
            ],
            "matchStrings": [
                "run-spec\\.yml@(?<currentValue>v[\\d.]+)",
                "spec-ref: (?<currentValue>v[\\d.]+)"
            ],
            "matchStringsStrategy": "any",
            "depNameTemplate": "Flagsmith/sdk-spec",
            "datasourceTemplate": "github-tags"
        }
    ],
    "packageRules": [
        {
            "matchPackageNames": [
                "Flagsmith/sdk-spec"
            ],
            "groupName": "SDK spec",
            "addLabels": [
                "sdk-spec"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "GitHub Actions",
            "addLabels": [
                "github-actions"
            ],
            "pinDigests": true
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "matchPackageNames": [
                "Flagsmith/sdk-spec"
            ],
            "enabled": false
        }
    ]
}
